# Unreal Engine 5 Gitignore for Project Blackout

# Binaries & Temporary Directories
Binaries/
Plugins/*/Binaries/
Saved/
Intermediate/
DerivedDataCache/
FileOpenOrder/

# Build Output Artifacts (Keep BUILD_MANIFEST.json tracked)
Build/*
!Build/BUILD_MANIFEST.json

# User-specific & IDE files
.vs/
.idea/
.vscode/
*.sln
*.suo
*.user
*.userosctable
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.tmp
*.log

# Crash reports & logs
Saved/Logs/
Saved/Crashes/
Saved/StagedBuilds/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini
