# Unreal Engine 5 Gitignore for Project Blackout

# Binaries & Temporary Directories
Binaries/
Plugins/*/Binaries/
Saved/
Intermediate/
DerivedDataCache/
FileOpenOrder/

# Build & Release Output Artifacts
Build/*
!Build/BUILD_MANIFEST.json
Release/*
!Release/RELEASE_MANIFEST.txt
!Release/Windows/Manifest.json
!Release/Windows/ProjectBlackout.exe
!Release/Windows/Content/Paks/ProjectBlackout-Windows.pak
!Release/Android/ProjectBlackout.apk
!Release/Android/ProjectBlackout.aab

# User-specific & IDE files
.vs/
.idea/
.vscode/
*.sln
*.suo
*.user
*.userosctable
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.tmp
*.log

# Crash reports & logs
Saved/Logs/
Saved/Crashes/
Saved/StagedBuilds/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini
