# Unreal Engine 5 Gitignore

# Executables, Libraries, and Binaries
Binaries/
Plugins/*/Binaries/
Build/
Saved/
Intermediate/
DerivedDataCache/
FileOpenOrder/

# User-specific & IDE files
.vs/
.idea/
.vscode/
*.sln
*.suo
*.user
*.userosctable
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Autogenerated files
/Script/

# Crash reports & logs
Saved/Logs/
Saved/Crashes/
Saved/StagedBuilds/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini
